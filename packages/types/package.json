{
  "name": "@esli-cosmetics/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types for Esli Cosmetics monorepo",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./database": {
      "types": "./src/database.ts",
      "default": "./src/database.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./src/auth.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@esli-cosmetics/config": "workspace:*",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/react": "^19.1.16"
  }
}

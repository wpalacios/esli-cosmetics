# Database
# Note: connection_limit is automatically added if not present (defaults to 5)
# You can override it by adding ?connection_limit=N to your DATABASE_URL or setting DATABASE_CONNECTION_LIMIT
DATABASE_URL="postgresql://username:password@localhost:5432/esli_cosmetics_dev?schema=public"
# Optional: Override default connection limit (used if not in DATABASE_URL)
# DATABASE_CONNECTION_LIMIT="5"

# JWT
# IMPORTANT: These secrets MUST match across all developers and environments
# If different, tokens created by one developer won't work for another (invalid signature errors)
JWT_SECRET="your-jwt-secret-key-here-min-32-chars-required"
# Expiration in seconds
# Access token should match cookie expiration (7 days) to prevent premature redirects
JWT_EXPIRES_IN="604800"        # 7 days (604800 seconds = 60*60*24*7)
JWT_REFRESH_SECRET="your-refresh-jwt-secret-key-here-min-32-chars-required"
JWT_REFRESH_EXPIRES_IN="2592000"  # 30 days (2592000 seconds = 60*60*24*30)

# Application
PORT=3001
NODE_ENV="development"
CORS_ORIGINS=http://localhost:3100,http://localhost:19006,exp://localhost:19000
# Business IANA time zone used to interpret calendar-day filters (orders/quotes).
# Defaults to America/Managua when unset.
APP_TIMEZONE="America/Managua"

# Prisma Studio
PRISMA_STUDIO_PORT=5555

# Product search — aliases (colloquial names for search)
# Heuristic aliases work without LLM; set URL for LLM-generated variants (Ollama OpenAI-compatible API)
# PRODUCT_ALIAS_LLM_URL="http://127.0.0.1:11434/v1"
# PRODUCT_ALIAS_LLM_API_KEY="ollama"
# PRODUCT_ALIAS_LLM_MODEL="qwen3-4b"

# Product search — semantic embeddings (pgvector hybrid search; optional)
# PRODUCT_SEARCH_EMBEDDING_URL="http://127.0.0.1:11434/v1"
# PRODUCT_SEARCH_EMBEDDING_API_KEY="ollama"
# PRODUCT_SEARCH_EMBEDDING_MODEL="nomic-embed-text"

  customerId String @map("customer_id") @db.Uuid

  principalAmount   Decimal @map("principal_amount") @db.Decimal(12, 2)
  outstandingAmount Decimal @map("outstanding_amount") @db.Decimal(12, 2)

  creditType       CreditType       @default(SHORT_TERM) @map("credit_type")
  installmentCount Int              @map("installment_count")
  paymentFrequency PaymentFrequency @default(WEEKLY) @map("payment_frequency")
  durationDays     Int?             @map("duration_days")
  firstDueDate     DateTime         @map("first_due_date") @db.Timestamptz(6)
  lastDueDate      DateTime         @map("last_due_date") @db.Timestamptz(6)
  status           CreditStatus     @default(PENDING) @map("status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  order        Order               @relation(fields: [orderId], references: [id])
  customer     Customer            @relation(fields: [customerId], references: [id])
  installments CreditInstallment[]

  @@index([customerId])
  @@index([status])
  @@index([orderId])
  @@map("credits")
}

model CreditInstallment {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creditId      String                  @map("credit_id") @db.Uuid
  installmentNo Int                     @map("installment_no")
  dueDate       DateTime                @map("due_date") @db.Timestamptz(6)
  amount        Decimal                 @db.Decimal(12, 2)
  paidAmount    Decimal                 @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status        CreditInstallmentStatus @default(PENDING) @map("status")

  // Relations
  credit      Credit       @relation(fields: [creditId], references: [id], onDelete: Cascade)
  payments    Payment[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([creditId, installmentNo])
  @@index([creditId])
  @@index([dueDate])
  @@index([status])
  @@map("credit_installments")
}

model CreditNote {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String?  @map("order_id") @db.Uuid
  paymentId           String?  @map("payment_id") @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  creditInstallmentId String?  @map("credit_installment_id") @db.Uuid
  amount              Decimal  @db.Decimal(12, 2)
  description         String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?  @map("created_by") @db.Uuid

  // Relations
  order             Order?             @relation(fields: [orderId], references: [id])
  payment           Payment?           @relation(fields: [paymentId], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])
  creditInstallment CreditInstallment? @relation(fields: [creditInstallmentId], references: [id])
  creator           User?              @relation(fields: [createdBy], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([paymentId])
  @@index([creditInstallmentId])
  @@index([createdAt])
  @@map("credit_notes")
}

model OrderAdjustment {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String              @map("order_id") @db.Uuid
  type      OrderAdjustmentType @map("type")
  amount    Decimal             @db.Decimal(12, 2)
  reason    String?             @db.Text
  createdBy String              @map("created_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator User  @relation("OrderAdjustmentCreator", fields: [createdBy], references: [id])

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@map("order_adjustments")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  channel   String?  @db.VarChar(255)
  title     String?  @db.VarChar(255)
  body      String?  @db.VarChar(255)
  payload   Json?    @db.JsonB
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String?  @db.VarChar(255)
  tableName String?  @map("table_name") @db.VarChar(255)
  recordId  String?  @map("record_id") @db.Uuid
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model ImportExportJob {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String?   @db.VarChar(255)
  entity     String?   @db.VarChar(255)
  status     String?   @db.VarChar(255)
  fileUrl    String?   @map("file_url") @db.Text
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  metadata   Json?     @db.JsonB

  // Relations
  creator User? @relation(fields: [createdBy], references: [id])

  @@map("import_export_jobs")
}

model CashRegister {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  name       String   @db.VarChar(255)
  code       String?  @unique @db.VarChar(255)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  location Location?     @relation(fields: [locationId], references: [id])
  sessions CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashRegisterId String    @map("cash_register_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedById     String?   @map("closed_by_id") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  openingBalance Decimal   @default(0) @map("opening_balance") @db.Decimal(12, 2)
  closingBalance Decimal?  @map("closing_balance") @db.Decimal(12, 2)
  systemTotal    Decimal?  @map("system_total") @db.Decimal(12, 2)
  difference     Decimal?  @map("difference") @db.Decimal(12, 2)
  status         String    @default("open") @db.VarChar(50)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id])
  employee     Employee       @relation(fields: [employeeId], references: [id])
  closedBy     Employee?      @relation("ClosedByEmployee", fields: [closedById], references: [id])
  movements    CashMovement[]
  orders       Order[]

  @@map("cash_sessions")
}

enum CashMovementType {
  IN
  OUT
}

model CashMovement {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cashSessionId    String           @map("cash_session_id") @db.Uuid
  type             CashMovementType @default(IN)
  amount           Decimal          @db.Decimal(12, 2)
  reason           String?          @db.Text
  referenceOrderId String?          @map("reference_order_id") @db.Uuid
  createdBy        String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  cashSession    CashSession @relation(fields: [cashSessionId], references: [id])
  referenceOrder Order?      @relation("CashMovementOrders", fields: [referenceOrderId], references: [id])
  creator        User?       @relation(fields: [createdBy], references: [id])

  @@map("cash_movements")
}

enum TransferStatus {
  CREATED
  ACCEPTED
  DISPATCHING
  IN_TRANSIT
  RECEIVED_COMPLETE
  RECEIVED_PARTIAL
  CANCELLED
}

model StockTransfer {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackingNumber  String                @unique @map("tracking_number") @db.VarChar(255)
  status          TransferStatus        @default(CREATED)
  // Ubicaciones
  fromLocationId  String                @map("from_location_id") @db.Uuid
  toLocationId    String                @map("to_location_id") @db.Uuid
  // Responsables
  createdById     String                @map("created_by_id") @db.Uuid
  senderId        String?               @map("sender_id") @db.Uuid
  receiverId      String?               @map("receiver_id") @db.Uuid
  // Tiempos
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt    DateTime?             @map("dispatched_at") @db.Timestamptz(6)
  receivedAt      DateTime?             @map("received_at") @db.Timestamptz(6)
  // Relaciones
  items           StockTransferItem[]
  logs            StockTransferLog[]
  movements       StockMovement[]       @relation("StockTransferMovements")
  fromLocation    Location              @relation("StockTransferFrom", fields: [fromLocationId], references: [id])
  toLocation      Location              @relation("StockTransferTo", fields: [toLocationId], references: [id])
  createdBy       User                  @relation("StockTransferCreator", fields: [createdById], references: [id])
  sender          User?                 @relation("StockTransferSender", fields: [senderId], references: [id])
  receiver        User?                 @relation("StockTransferReceiver", fields: [receiverId], references: [id])
  
  @@index([status])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId         String   @map("transfer_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  productVariantId   String?  @map("product_variant_id") @db.Uuid
  quantityRequested  Decimal  @map("quantity_requested") @db.Decimal
  quantitySent       Decimal? @map("quantity_sent") @db.Decimal
  quantityReceived   Decimal? @map("quantity_received") @db.Decimal
  transfer           StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id])
  productVariant     ProductVariant? @relation(fields: [productVariantId], references: [id])
  
  @@index([transferId])
  @@index([productId])
  @@index([productVariantId])
  @@map("stock_transfer_items")
}

model StockTransferLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId      String   @map("transfer_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  previousStatus  TransferStatus @map("previous_status")
  newStatus       TransferStatus @map("new_status")
  note            String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  user            User         @relation("StockTransferLogUser", fields: [userId], references: [id])
  
  @@index([transferId])
  @@index([createdAt])
  @@map("stock_transfer_logs")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LocationType {
  STORE
  WAREHOUSE
  DISTRIBUTION_CENTER
  POPUP_STORE
}

enum StockMovementType {
  PURCHASE
  SALE
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  TRANSFER
  ANNULMENT
  DAMAGE
  RETURN
  RESTOCK
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductType {
  STANDARD  
  KIT       
}

model User {
  id          String    @id @db.Uuid
  email       String    @unique @db.VarChar(255)
  password    String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  employees                 Employee[]
  customers                 Customer[]
  userRoles                 UserRole[]
  stockMovements            StockMovement[]
  purchaseOrders            PurchaseOrder[]
  payments                  Payment[]
  reversedPayments          Payment[]             @relation("PaymentReversedBy")
  creditNotes               CreditNote[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  importExportJobs          ImportExportJob[]
  assignedDiscountCodes     CustomerDiscountCode[]
  createdCustomerPrices     CustomerPrice[]
  cashMovements             CashMovement[]
  createdQuotes             Quote[]
  orderItemAnnulmentCreator OrderItemAnnulment[]   @relation("OrderItemAnnulmentCreator")
  orderAdjustmentCreator    OrderAdjustment[]      @relation("OrderAdjustmentCreator")
  stockTransfersCreated     StockTransfer[]        @relation("StockTransferCreator")
  stockTransfersSent        StockTransfer[]        @relation("StockTransferSender")
  stockTransfersReceived    StockTransfer[]        @relation("StockTransferReceiver")
  stockTransferLogs         StockTransferLog[]     @relation("StockTransferLogUser")

  @@map("users")
}

model Person {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String    @map("first_name") @db.VarChar(255)
  lastName  String?   @map("last_name") @db.VarChar(255)
  phone     String?   @db.VarChar(255)
  email     String?   @db.VarChar(255)
  docType   String?   @map("doc_type") @db.VarChar(255)
  docNumber String?   @map("doc_number") @db.VarChar(255)
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  metadata  Json      @default("{}") @db.JsonB

  // Relations
  employees Employee[]
  customers Customer[]
  addresses Address[]

  @@map("people")
}

model Branch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(255)
  code              String?   @db.VarChar(255)
  address           String?   @db.Text
  phone             String?   @db.VarChar(255)
  managerEmployeeId String?   @map("manager_employee_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  managerEmployee Employee?       @relation("BranchManager", fields: [managerEmployeeId], references: [id])
  userRoles       UserRole[]
  addresses       Address[]
  locations       Location[]
  purchaseOrders  PurchaseOrder[]
  orders          Order[]
  quotes          Quote[]

  @@map("branches")
}

model Employee {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  employeeCode String?   @map("employee_code") @db.VarChar(255)
  roleTitle    String?   @map("role_title") @db.VarChar(255)
  locationId   String?   @map("location_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  hiredAt      DateTime? @map("hired_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  person          Person        @relation(fields: [personId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  location        Location?     @relation(fields: [locationId], references: [id])
  managedBranches Branch[]      @relation("BranchManager")
  sellerOrders    Order[]       @relation("SellerOrders")
  cashierOrders   Order[]       @relation("CashierOrders")
  sellerQuotes    Quote[]       @relation("SellerQuotes")
  cashierQuotes   Quote[]       @relation("CashierQuotes")
  cashSessions    CashSession[]
  closedSessions  CashSession[] @relation("ClosedByEmployee")

  @@map("employees")
}

model Customer {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId                String    @map("person_id") @db.Uuid
  userId                  String?   @map("user_id") @db.Uuid
  customerTypeId          String?   @map("customer_type_id") @db.Uuid
  externalId              String?   @map("external_id") @db.VarChar(255)
  defaultBillingAddressId String?   @map("default_billing_address_id") @db.Uuid
  isDeleted               Boolean   @default(false) @map("is_deleted")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)
  metadata                Json      @default("{}") @db.JsonB
  creditAllowed           Boolean?  @default(false) @map("credit_allowed")
  creditLimit             Decimal?  @map("credit_limit") @db.Decimal(12, 2)
  initialOpeningBalance   Decimal?  @default(0) @map("initial_opening_balance") @db.Decimal(12, 2)

  // Relations
  person                Person                 @relation(fields: [personId], references: [id])
  user                  User?                  @relation(fields: [userId], references: [id])
  customerType          CustomerType?          @relation(fields: [customerTypeId], references: [id])
  defaultBillingAddress Address?               @relation(fields: [defaultBillingAddressId], references: [id])
  orders                Order[]
  quotes                Quote[]
  credits               Credit[]
  payments              Payment[]
  creditNotes           CreditNote[]
  discountCodes         CustomerDiscountCode[]
  customerPrices        CustomerPrice[]

  @@map("customers")
}

model CustomerPrice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  priceTypeId String    @map("price_type_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceType PriceType @relation(fields: [priceTypeId], references: [id], onDelete: Cascade)
  creator   User?     @relation(fields: [createdBy], references: [id])

  @@unique([customerId, priceTypeId])
  @@map("customer_prices")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique @db.VarChar(255)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique @db.VarChar(255)
  name        String?   @db.VarChar(255)
  description String?   @db.Text
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
  @@map("user_roles")
}

model RolePermission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Country {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String? @db.VarChar(255)
  code      String? @db.VarChar(255)
  isDeleted Boolean @default(false) @map("is_deleted")

  // Relations
  departments Department[]
  addresses   Address[]

  @@map("country")
}

model Department {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId String? @map("country_id") @db.Uuid
  name      String? @db.VarChar(255)
  code      String? @db.VarChar(255)
  isDeleted Boolean @default(false) @map("is_deleted")

  // Relations
  country        Country?       @relation(fields: [countryId], references: [id])
  municipalities Municipality[]
  addresses      Address[]

  @@map("department")
}

model Municipality {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  name         String? @db.VarChar(255)
  isDeleted    Boolean @default(false) @map("is_deleted")

  // Relations
  department Department? @relation(fields: [departmentId], references: [id])
  addresses  Address[]

  @@map("municipality")
}

model Address {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId       String?   @map("person_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  address        String?   @db.Text
  city           String?   @db.VarChar(255)
  countryId      String?   @map("country_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  municipalityId String?   @map("municipality_id") @db.Uuid
  postalCode     String?   @map("postal_code") @db.VarChar(255)
  geo            Json?     @db.JsonB
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  person       Person?       @relation(fields: [personId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  country      Country?      @relation(fields: [countryId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  municipality Municipality? @relation(fields: [municipalityId], references: [id])
  customers    Customer[]

  @@map("addresses")
}

model Location {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String?      @map("branch_id") @db.Uuid
  name         String       @db.VarChar(255)
  locationType LocationType @default(STORE) @map("location_type")
  address      String?      @db.Text
  contact      String?      @db.VarChar(255)
  isDeleted    Boolean      @default(false) @map("is_deleted")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  // Relations
  branch             Branch?         @relation(fields: [branchId], references: [id])
  employees          Employee[]
  stockLevels        StockLevel[]
  stockMovementsFrom StockMovement[] @relation("FromLocation")
  stockMovementsTo   StockMovement[] @relation("ToLocation")
  stockTransfersFrom StockTransfer[]  @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[]  @relation("StockTransferTo")
  orders             Order[]
  quotes             Quote[]
  cashRegisters      CashRegister[]

  @@map("locations")
}

model TaxRate {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?   @db.VarChar(255)
  code      String?   @db.VarChar(255)
  rate      Decimal?  @db.Decimal(5, 2)
  active    Boolean   @default(true)
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  products Product[]

  @@map("tax_rates")
}

model PriceType {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(255)
  minQuantity Int       @default(1) @map("minimum_quantity")
  priority    Int       @unique @default(1) @map("priority")
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  variantPrices  ProductVariantPrice[]
  customerPrices CustomerPrice[]
  quoteItems     QuoteItem[]
  orderItems     OrderItem[]

  @@map("price_types")
}

model CustomerType {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(255)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customers Customer[]

  @@map("customer_types")
}

/**
 * Admin/Manager Creates discount codes (DiscountCode).
 * Assigns one or more codes to customers (CustomerDiscountCode).
 * POS / Ecommerce Flow
 * Customer provides or system detects a valid code.
 * The system validates:
 * Active status
 * Date range
 * Minimum purchase (if any)
 * Usage limit not exceeded
 * Assigned to the current customer (if required)
 * If valid:
 * Apply discount at order level.
 * Save discountCodeId and discountAmount in Order.
 * Optionally increment usageCount in DiscountCode.
 * Mark CustomerDiscountCode.isRedeemed = true.
 * Example: Discount Logic
 * Type = PERCENTAGE → apply order.subtotal * (value / 100)
 * Type = FIXED → subtract value directly.
 * Respect maxDiscount if set.
 * Store the final applied amount in Order.discountAmount.
 */
model DiscountCode {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String       @unique @db.VarChar(50) // e.g. "ESLI10OFF"
  name         String?      @db.VarChar(255)
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(10, 2) // either % or fixed amount depending on type
  minPurchase  Decimal?     @map("min_purchase") @db.Decimal(12, 2)
  maxDiscount  Decimal?     @map("max_discount") @db.Decimal(12, 2)
  usageLimit   Int?         @map("usage_limit") // optional limit (total uses per customer)
  startDate    DateTime?    @map("start_date") @db.Timestamptz(6)
  endDate      DateTime?    @map("end_date") @db.Timestamptz(6)
  isActive     Boolean      @default(true) @map("isActive")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customerDiscountCodes CustomerDiscountCode[]
  orders                Order[]
  quotes                Quote[]

  @@map("discount_codes")
}

model CustomerDiscountCode {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  discountCodeId String    @map("discount_code_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  usageCount     Int       @default(0) @map("usage_count")
  isRedeemed     Boolean   @default(false) @map("isRedeemed")
  redeemedAt     DateTime? @map("redeemed_at") @db.Timestamptz(6)
  isDeleted      Boolean   @default(false) @map("is_deleted")

  // Relations
  customer     Customer     @relation(fields: [customerId], references: [id])
  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id])
  assignedBy   User?        @relation(fields: [assignedById], references: [id])

  @@unique([customerId, discountCodeId])
  @@map("customer_discount_codes")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  slug        String?   @unique @db.Text
  description String?   @db.Text
  parentId    String?   @map("parent_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  description String?
  websiteUrl  String?   @map("website_url") @db.VarChar(255)
  logoUrl     String?   @map("logo_url") @db.VarChar(255)
  country     String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  suppliers        SupplierBrand[]
  products         Product[]
  supplierProducts SupplierProduct[]

  @@index([name])
  @@map("brands")
}

model Product {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                String?   @unique @db.VarChar(255)
  barcode            String?   @unique @db.VarChar(255)
  name               String    @db.VarChar(255)
  description        String?   @db.Text
  brandId            String?   @map("brand_id") @db.Uuid
  categoryId         String?   @map("category_id") @db.Uuid
  taxRateId          String?   @map("tax_rate_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  metadata           Json      @default("{}") @db.JsonB
  defaultVariantOnly Boolean   @default(false) @map("default_variant_only")
  type               ProductType @default(STANDARD)
  expirationDate     DateTime?   @map("expiration_date") @db.Timestamptz(6)

  // Relations
  brand            Brand?            @relation(fields: [brandId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  taxRate          TaxRate?          @relation(fields: [taxRateId], references: [id])
  variants         ProductVariant[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  stockTransferItems StockTransferItem[]
  orderItems       OrderItem[]
  quoteItems       QuoteItem[]
  supplierProducts SupplierProduct[]
  kitItems         ProductKitItem[]  @relation("KitProduct")
  images           ProductImage[]

  @@map("products")
}

model VariantAlias {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productVariantId String  @map("product_variant_id") @db.Uuid
  alias           String   @db.VarChar(512)
  normalizedAlias String   @map("normalized_alias") @db.VarChar(512)
  source          String   @default("manual") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, normalizedAlias])
  @@index([productVariantId])
  @@index([normalizedAlias])
  @@map("variant_aliases")
}

model VariantEmbedding {
  productVariantId String   @id @map("product_variant_id") @db.Uuid
  modelVersion     String   @map("model_version") @db.VarChar(64)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("variant_embeddings")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(1024)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  isDeleted Boolean  @default(false) @map("is_deleted")
